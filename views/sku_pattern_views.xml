<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree view for SKU Pattern Component -->
    <record id="view_sku_pattern_component_tree" model="ir.ui.view">
        <field name="name">sku.pattern.component.tree</field>
        <field name="model">sku.pattern.component</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="component_type"/>
                <field name="fixed_value" invisible="component_type != 'fixed'" required="component_type == 'fixed'"/>
                <field name="length" invisible="component_type not in ('name', 'category')"/>
                <field name="case" invisible="component_type not in ('name', 'category')"/>
                <field name="attribute_id" invisible="component_type != 'attribute'" required="component_type == 'attribute'"/>
                <field name="date_format" invisible="component_type != 'date'" required="component_type == 'date'"/>
                <field name="padding" invisible="component_type != 'sequence'"/>
                <field name="separator"/>
            </list>
        </field>
    </record>

    <record id="view_sku_pattern_form" model="ir.ui.view">
        <field name="name">sku.pattern.form</field>
        <field name="model">sku.pattern</field>
        <field name="arch" type="xml">
            <form string="SKU Pattern">
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name" placeholder="e.g. Standard Product SKU"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="is_default"/>
                            <field name="sequence_id"/>
                        </group>
                        <group>
                            <field name="example_sku" readonly="1" decoration-bf="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Components">
                            <field name="component_ids" context="{'default_pattern_id': id}">
                                <list editable="bottom" create="1" delete="1">
                                    <field name="sequence" widget="handle"/>
                                    <field name="component_type"/>
                                    <field name="fixed_value" invisible="component_type != 'fixed'" required="component_type == 'fixed'"/>
                                    <field name="length" invisible="component_type not in ('name', 'category')"/>
                                    <field name="case" invisible="component_type not in ('name', 'category')"/>
                                    <field name="attribute_id" invisible="component_type != 'attribute'" required="component_type == 'attribute'"/>
                                    <field name="date_format" invisible="component_type != 'date'" required="component_type == 'date'"/>
                                    <field name="padding" invisible="component_type != 'sequence'"/>
                                    <field name="separator"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_sku_pattern_tree" model="ir.ui.view">
        <field name="name">sku.pattern.tree</field>
        <field name="model">sku.pattern</field>
        <field name="arch" type="xml">
            <list string="SKU Patterns">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="is_default"/>
                <field name="example_sku"/>
            </list>
        </field>
    </record>

    <record id="action_sku_pattern" model="ir.actions.act_window">
        <field name="name">SKU Configurations</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">sku.pattern</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_sku_config"
              name="SKU Configurations"
              parent="stock.menu_stock_config_settings"
              action="action_sku_pattern"
              sequence="100"/>
</odoo>
